# Local development only. This is a host path to a file that must remain untracked.
# The file must contain only the local PostgreSQL password.
RELYTHRA_POSTGRES_PASSWORD_FILE=../../secrets/postgres_password
# The file must contain only the management API bearer token.
RELYTHRA_MANAGEMENT_TOKEN_FILE=../../secrets/management_token

# Demo-only outbound policy. Private and HTTP access are enabled solely so the
# local Compose network can be used when a Prometheus service is added.
RELYTHRA_DATASOURCE_ALLOWED_HOSTS=prometheus
RELYTHRA_DATASOURCE_ALLOWED_PORTS=9090
RELYTHRA_DATASOURCE_ALLOW_HTTP=true
RELYTHRA_DATASOURCE_ALLOW_PRIVATE=true

RELYTHRA_API_PORT=8080
RELYTHRA_WORKER_PORT=8081
RELYTHRA_WEB_PORT=3000
RELYTHRA_POSTGRES_PORT=15432
