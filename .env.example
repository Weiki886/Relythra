# Local development only. This is a host path to a file that must remain untracked.
# The file must contain only the local PostgreSQL password.
RELYTHRA_POSTGRES_PASSWORD_FILE=../../secrets/postgres_password
# The file must contain only the management API bearer token.
RELYTHRA_MANAGEMENT_TOKEN_FILE=../../secrets/management_token

# Demo-only outbound policy. Private and HTTP access are enabled solely so the
# local Compose network can be used when a Prometheus service is added.
RELYTHRA_DATASOURCE_ALLOWED_HOSTS=prometheus
RELYTHRA_DATASOURCE_ALLOWED_PORTS=9090
RELYTHRA_DATASOURCE_ALLOW_HTTP=true
RELYTHRA_DATASOURCE_ALLOW_PRIVATE=true

RELYTHRA_API_PORT=8080
RELYTHRA_WORKER_PORT=8081
RELYTHRA_WEB_PORT=3000
RELYTHRA_POSTGRES_PORT=15432

# Optional demo overlay (scripts/demo.sh). Separate credentials, never reuse the
# control database / management token. Generate observability token as 32+ hex chars.
DEMO_OWNER_PASSWORD_FILE=../../secrets/demo_owner_password
DEMO_READER_PASSWORD_FILE=../../secrets/demo_reader_password
DEMO_OBSERVABILITY_TOKEN_FILE=../../secrets/observability_token
DEMO_GRAFANA_PASSWORD_FILE=../../secrets/grafana_admin_password
DEMO_ORDERS_PORT=18090
DEMO_PROMETHEUS_PORT=19090
DEMO_LOKI_PORT=13100
DEMO_GRAFANA_PORT=13001
# CI/CD webhook configuration is consumed by the API process when enabled.
# Keep the secret file outside the repository and provide its path directly to the API.
# RELYTHRA_DEPLOYMENT_WEBHOOK_SECRET_REF=file:/run/secrets/deployment_webhook_secret
# RELYTHRA_DEPLOYMENT_WEBHOOK_SOURCE=github-actions
# Reserved for the notification adapter.
# RELYTHRA_NOTIFICATION_TEST_WEBHOOK_REF=file:/run/secrets/notification_test_webhook
